+++ b/lib/calendrical/astronomy_tables.ex
@@ -0,0 +1,110 @@
+defmodule Calendrical.AstronomyTables do
+  @moduledoc false
+
+  # The tables of years a calendar would otherwise work out by astronomy on
+  # every call, for the Gregorian years of the ephemeris Astro bundles,
+  # 1900 to 2100. Each is a CSV file in `priv/astronomy`, generated from
+  # the astronomy by `mix calendrical.astronomy_tables`, compiled into its
+  # calendar and looked up there; a year outside a table is worked out as
+  # before. A table is regenerated when Astro's positions change, and
+  # `mix calendrical.astronomy_tables --check` reports a table that no
+  # longer matches the astronomy.
+
+  # The tables, by name: the file each is kept in, the header it carries,
+  # and the function of this module that works its rows out.
+  @tables %{
+    persian: %{
+      file: "persian_new_years.csv",
+      header: ["persian_year", "new_year"],
+      rows: :persian_rows
+    }
+  }
+
+  @doc false
+  def tables, do: Map.keys(@tables)
+
+  @doc false
+  def path(table), do: Path.join([priv_dir(), "astronomy", Map.fetch!(@tables, table).file])
+
+  # At compile time the calendar reads its table from the project's own
+  # `priv`, where `:code.priv_dir/1` is not yet the built application's.
+  defp priv_dir, do: Path.expand("../../priv", __DIR__)
+
+  @doc false
+  # The rows of a table, worked out from the astronomy.
+  def rows(table), do: apply(__MODULE__, Map.fetch!(@tables, table).rows, [])
+
+  # The Persian new year of each Persian year that begins in the
+  # Gregorian years of the bundled ephemeris, by the equinox and true noon
+  # in Tehran.
+  @doc false
+  def persian_rows do
+    for gregorian_year <- 1900..2100 do
+      {:ok, new_year} = Calendrical.Persian.astronomical_new_year(gregorian_year)
+      [gregorian_year - 621, Date.to_iso8601(new_year)]
+    end
+  end
+
+  @doc false
+  # The ISO day of each Persian new year in the table, in order from its
+  # first year, for `Calendrical.Persian` to compile in. A table that does
+  # not hold one Nowruz in March of each of the years it should fails the
+  # build rather than move a year's start.
+  def persian_new_years!(years) do
+    rows = read(:persian)
+
+    unless length(rows) == Enum.count(years) do
+      raise "#{path(:persian)}: #{length(rows)} rows, where #{Enum.count(years)} are needed"
+    end
+
+    for {[year, new_year], expected_year} <- Enum.zip(rows, years) do
+      date = Date.from_iso8601!(new_year)
+
+      unless String.to_integer(year) == expected_year and date.year == expected_year + 621 and
+               date.month == 3 and date.day in 19..22 do
+        raise "#{path(:persian)}: invalid row for year #{expected_year}: #{year},#{new_year}"
+      end
+
+      Date.to_gregorian_days(date)
+    end
+  end
+
+  @doc false
+  # The table as its file holds it, as lists of the strings of each row.
+  def read(table) do
+    %{header: header} = Map.fetch!(@tables, table)
+    [file_header | rows] = table |> path() |> File.read!() |> String.split("\n", trim: true)
+
+    unless String.split(file_header, ",") == header do
+      raise "#{path(table)}: the header is #{file_header}, where it must be #{Enum.join(header, ",")}"
+    end
+
+    Enum.map(rows, &String.split(&1, ","))
+  end
+
+  @doc false
+  # Writes a table's rows to its file.
+  def write(table, rows) do
+    %{header: header} = Map.fetch!(@tables, table)
+    lines = [header | Enum.map(rows, &Enum.map(&1, fn value -> to_string(value) end))]
+    content = Enum.map_join(lines, "", &(Enum.join(&1, ",") <> "\n"))
+    File.mkdir_p!(Path.dirname(path(table)))
+    File.write!(path(table), content)
+  end
+
+  @doc false
+  # The rows of the file that differ from the astronomy, as
+  # `{row in the file, row worked out}`.
+  def differences(table) do
+    worked_out = Enum.map(rows(table), fn row -> Enum.map(row, &to_string/1) end)
+    stored = read(table)
+
+    if length(stored) == length(worked_out) do
+      for {stored_row, worked_out_row} <- Enum.zip(stored, worked_out),
+          stored_row != worked_out_row,
+          do: {stored_row, worked_out_row}
+    else
+      [{:rows, length(stored), length(worked_out)}]
+    end
+  end
+end
