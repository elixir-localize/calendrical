diff --git a/lib/mix/tasks/calendrical.astronomy_tables.ex b/lib/mix/tasks/calendrical.astronomy_tables.ex
new file mode 100644
index 0000000..6c37179
--- /dev/null
+++ b/lib/mix/tasks/calendrical.astronomy_tables.ex
@@ -0,0 +1,66 @@
+defmodule Mix.Tasks.Calendrical.AstronomyTables do
+  @shortdoc "Generates or checks the tables of the calendars reckoned by astronomy"
+
+  @moduledoc """
+  Generates the tables of the calendars that find their years by
+  astronomy, or checks them against the astronomy.
+
+  A calendar reckoned by astronomy, such as `Calendrical.Persian`, would
+  work out a year's astronomy on every call. For the Gregorian years of the
+  ephemeris Astro bundles, 1900 to 2100, it looks the year up instead in a
+  table kept in `priv/astronomy`, compiled into the calendar; years outside
+  the table are worked out as before. This task writes those tables from
+  the astronomy, and is run again when Astro's positions change.
+
+  ## Usage
+
+      mix calendrical.astronomy_tables
+      mix calendrical.astronomy_tables --check
+
+  ## Options
+
+  * `--check` writes nothing, and compares each table with the astronomy,
+    failing if any row differs.
+
+  """
+
+  use Mix.Task
+
+  alias Calendrical.AstronomyTables
+
+  @requirements ["app.start"]
+
+  @impl Mix.Task
+  def run(arguments) do
+    {options, _rest, _invalid} = OptionParser.parse(arguments, strict: [check: :boolean])
+
+    if Keyword.get(options, :check, false), do: check(), else: generate()
+  end
+
+  defp generate do
+    for table <- AstronomyTables.tables() do
+      rows = AstronomyTables.rows(table)
+      AstronomyTables.write(table, rows)
+      Mix.shell().info("#{table}: #{length(rows)} rows written to #{AstronomyTables.path(table)}")
+    end
+  end
+
+  defp check do
+    failures =
+      for table <- AstronomyTables.tables(), reduce: 0 do
+        count ->
+          case AstronomyTables.differences(table) do
+            [] ->
+              Mix.shell().info("#{table}: matches the astronomy")
+              count
+
+            differences ->
+              Mix.shell().error("#{table}: #{length(differences)} rows differ from the astronomy")
+              Enum.each(Enum.take(differences, 10), &Mix.shell().error("  #{inspect(&1)}"))
+              count + 1
+          end
+      end
+
+    if failures > 0, do: Mix.raise("#{failures} astronomy tables differ from the astronomy")
+  end
+end
