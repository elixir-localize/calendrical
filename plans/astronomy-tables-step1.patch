index 0000000..92160c2
--- /dev/null
+++ b/test/astronomy_tables_test.exs
@@ -0,0 +1,55 @@
+defmodule Calendrical.AstronomyTablesTest do
+  @moduledoc """
+  The tables of years a calendar would otherwise work out by astronomy on
+  every call (`priv/astronomy`, written by `mix calendrical.astronomy_tables`)
+  hold what the astronomy gives, and the calendars answer from them as
+  they answered from the astronomy.
+
+  """
+
+  use ExUnit.Case, async: true
+
+  alias Calendrical.AstronomyTables
+
+  describe "the Persian table" do
+    test "holds the new year the astronomy gives for every year" do
+      assert AstronomyTables.differences(:persian) == []
+    end
+
+    test "is the calendar's new year for every year it holds" do
+      for gregorian_year <- 1900..2100 do
+        {:ok, nowruz} = Calendrical.Persian.astronomical_new_year(gregorian_year)
+        persian_year = gregorian_year - 621
+
+        assert Calendrical.Persian.new_year_gregorian(gregorian_year) == {:ok, nowruz}
+
+        assert Calendrical.Persian.date_to_iso_days(persian_year, 1, 1) ==
+                 Date.to_gregorian_days(nowruz)
+
+        assert Calendrical.Persian.date_from_iso_days(Date.to_gregorian_days(nowruz)) ==
+                 {persian_year, 1, 1}
+      end
+    end
+
+    test "joins the arithmetic years either side without a gap" do
+      for year <- [1278, 1279, 1479] do
+        assert Calendrical.Persian.date_to_iso_days(
+                 year,
+                 12,
+                 Calendrical.Persian.days_in_month(year, 12)
+               ) +
+                 1 == Calendrical.Persian.date_to_iso_days(year + 1, 1, 1)
+      end
+    end
+
+    test "fails the build where it does not hold the years it should" do
+      assert_raise RuntimeError, ~r/rows, where 200 are needed/, fn ->
+        AstronomyTables.persian_new_years!(1279..1478)
+      end
+
+      assert_raise RuntimeError, ~r/invalid row for year 1280/, fn ->
+        AstronomyTables.persian_new_years!(1280..1480)
+      end
+    end
+  end
+end
